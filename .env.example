# Zkopíruj na .env a uprav. Pro TrueNAS Apps UI vlož hodnoty přímo do
# 'environment' v compose (UI .env nečte).

# Kam proxy posílá Ollama API (kontejner Open WebUI s vestavěnou Ollamou)
OLLAMA_UPSTREAM=http://open-webui:11434

# Port, na kterém poběží proxy (API i GUI /ui)
PROXY_PORT=11435

# Počáteční admin účet GUI (založí se jen do prázdné databáze).
# Prázdné heslo = admin / admin123 — po přihlášení hned změň.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ukládat text dotazů a odpovědí (1) nebo jen metriky (0); dá se přepnout v GUI
OLLAMA_LOG_BODIES=1

# Kam ukládat binární výsledky úloh (audio z TTS); výchozí /data/jobs vedle databáze
# OLLAMA_JOBS_DIR=/data/jobs

# Self-update z Gitu při každém restartu kontejneru
UPDATE_ON_START=true
REPO_URL=https://github.com/hulek-ales/OllamaProxy.git
REPO_BRANCH=main

# Lokálně postavený image: never | veřejný GHCR: always
# APP_PULL_POLICY=always
